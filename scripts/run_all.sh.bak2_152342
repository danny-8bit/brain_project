#!/usr/bin/env bash
# ============================================================
# BraTS2021 SOTA Pipeline (流水线版 - 14GB 磁盘适配)
# ============================================================
set -uo pipefail

# ========== 激活虚拟环境 ==========
# 兼容 tmux 新会话场景（不会继承父 shell 的环境）
if [[ -z "${VIRTUAL_ENV:-}" ]] && [[ -f "$(dirname "${BASH_SOURCE[0]}")/../brain/bin/activate" ]]; then
    source "$(dirname "${BASH_SOURCE[0]}")/../brain/bin/activate"
    echo "[env] activated venv: $VIRTUAL_ENV"
fi

# 验证 Python 和关键依赖
if ! python -c "import monai, torch" 2>/dev/null; then
    echo "[FATAL] Python 环境异常，找不到 monai/torch"
    echo "  当前 Python: $(which python)"
    echo "  请手动激活: source brain/bin/activate"
    exit 1
fi

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

DATA_ROOT="${DATA_ROOT:-./data/BraTS2021_TrainingData}"
FOLDS_JSON="${FOLDS_JSON:-./data/folds.json}"
WORK_DIR="${WORK_DIR:-./work_dir}"
LOG_DIR="${LOG_DIR:-./logs}"
STATE_DIR="${STATE_DIR:-./run_state}"
PROBS_DIR="${PROBS_DIR:-/dev/shm/brats_probs}"

MONAI_MODELS=("segresnet" "swinunetr")
FOLDS=(0 1 2 3 4)
GPU=0

SMOKE_TEST=0
RUN_NNUNET=0
RUN_TRAIN=1
RUN_INFER=1

for arg in "$@"; do
    case "$arg" in
        --smoke)       SMOKE_TEST=1 ;;
        --no-nnunet)   RUN_NNUNET=0 ;;
        --infer-only)  RUN_TRAIN=0 ;;
        --no-infer)    RUN_INFER=0 ;;
    esac
done

mkdir -p "$LOG_DIR" "$STATE_DIR" "$WORK_DIR" "$PROBS_DIR"

C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'

MAIN_LOG="$LOG_DIR/run_all.log"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$MAIN_LOG"; }

section() {
    log ""
    log "${C_BOLD}${C_CYAN}===================================================${C_RST}"
    log "${C_BOLD}${C_CYAN}  $1${C_RST}"
    log "${C_BOLD}${C_CYAN}===================================================${C_RST}"
}

format_time() {
    local sec=$1
    if [[ $sec -lt 60 ]]; then echo "${sec}s"
    elif [[ $sec -lt 3600 ]]; then printf "%dm%02ds" $((sec/60)) $((sec%60))
    else printf "%dh%02dm" $((sec/3600)) $((sec%3600/60))
    fi
}

run_step() {
    local step="$1"; shift
    local log_file="$LOG_DIR/${step}.log"
    local state_file="$STATE_DIR/${step}.state"

    if [[ -f "$state_file" && "$(cut -d'|' -f1 $state_file)" == "done" ]]; then
        log "${C_BLUE}[SKIP]${C_RST}  $step (已完成)"
        return 0
    fi

    log "${C_YELLOW}[START]${C_RST} $step"
    echo "running|$(date +%s)" > "$state_file"
    local t0=$(date +%s)

    if "$@" >"$log_file" 2>&1; then
        local elapsed=$(($(date +%s) - t0))
        echo "done|$elapsed" > "$state_file"
        log "${C_GREEN}[DONE]${C_RST}  $step (耗时 $(format_time $elapsed))"
        return 0
    else
        local rc=$?
        local elapsed=$(($(date +%s) - t0))
        echo "failed|$elapsed|$rc" > "$state_file"
        log "${C_RED}[FAIL]${C_RST}  $step (exit=$rc 耗时 $(format_time $elapsed))"
        log "       日志: $log_file"
        return $rc
    fi
}

check_env() {
    section "环境检查"
    nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader 2>&1 | head -n 1 | \
        while read l; do log "  GPU: $l"; done
    log "  数据 cases: $(find $DATA_ROOT -maxdepth 1 -mindepth 1 -type d | wc -l)"
    log "  磁盘: $(df -h /root/autodl-tmp 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5")"}')"
    log "  /dev/shm: $(df -h /dev/shm | awk 'NR==2{print $3"/"$2" ("$5")"}')"
    log "  内存: $(free -h | awk 'NR==2{print $3"/"$2", available="$7}')"
}

prepare_data() {
    section "数据准备"
    if [[ ! -f "$FOLDS_JSON" ]]; then
        run_step "make_folds" \
            python scripts/make_folds.py \
                --data_root "$DATA_ROOT" \
                --out "$FOLDS_JSON" --num_folds 5
    else
        log "${C_BLUE}[SKIP]${C_RST}  make_folds"
    fi
}

smoke_test() {
    section "冒烟测试 (50 epoch)"
    cat > /tmp/smoke_base.yaml <<EOF
seed: 2024
gpu: 0
amp: true
deep_supervision: true
ema: true
ema_decay: 0.999
grad_clip: 1.0
data_root: $DATA_ROOT
folds_json: $FOLDS_JSON
num_folds: 5
num_workers: 8
cache_rate: 0.3
roi_size: [128, 128, 128]
batch_size: 2
sw_batch_size: 4
max_epochs: 50
warmup_epochs: 5
val_interval: 25
lr: 3.0e-4
weight_decay: 1.0e-5
use_swa: false
save_last: false
work_dir: ./work_dir_smoke
EOF
    run_step "smoke_test" \
        python scripts/train.py \
            --base_config /tmp/smoke_base.yaml \
            --model_config configs/segresnet.yaml \
            --fold 0 --gpu $GPU
}

# === 流水线：训练完一个 fold 立刻推理 ===
train_and_predict_fold() {
    local model="$1"
    local fold="$2"

    run_step "train_${model}_fold${fold}" \
        python scripts/train.py \
            --base_config configs/base.yaml \
            --model_config "configs/${model}.yaml" \
            --fold $fold --gpu $GPU || return $?

    local ckpt="$WORK_DIR/${model}/fold_${fold}/best.pt"
    if [[ ! -f "$ckpt" ]]; then
        log "${C_YELLOW}[SKIP]${C_RST} predict (ckpt 不存在)"
        return 0
    fi

    run_step "predict_${model}_fold${fold}" \
        python scripts/predict.py \
            --base_config configs/base.yaml \
            --model_config "configs/${model}.yaml" \
            --ckpt "$ckpt" \
            --fold $fold \
            --out_dir "${PROBS_DIR}/${model}/fold_${fold}" \
            --use_ema --tta \
            --save_csv \
            --model_name "$model"
}

merge_oof() {
    local model="$1"
    log "${C_CYAN}[MERGE]${C_RST} 合并 ${model} OOF..."
    mkdir -p "${PROBS_DIR}/${model}_oof"
    cp -n ${PROBS_DIR}/${model}/fold_*/*.npz "${PROBS_DIR}/${model}_oof/" 2>/dev/null || true
    local n=$(ls "${PROBS_DIR}/${model}_oof/"*.npz 2>/dev/null | wc -l)
    log "${C_GREEN}[INFO]${C_RST}  ${model} OOF: ${n} cases，占用 $(du -sh ${PROBS_DIR}/${model}_oof 2>/dev/null | cut -f1)"
}

ensemble_and_search() {
    section "融合 + 网格搜索"
    local prob_dirs=()
    for m in "${MONAI_MODELS[@]}"; do
        if [[ -d "${PROBS_DIR}/${m}_oof" ]] && \
           [[ $(ls "${PROBS_DIR}/${m}_oof"/*.npz 2>/dev/null | wc -l) -gt 0 ]]; then
            prob_dirs+=("${PROBS_DIR}/${m}_oof")
        fi
    done

    if [[ ${#prob_dirs[@]} -lt 1 ]]; then
        log "${C_RED}[FAIL]${C_RST} 无概率图"
        return 1
    fi

    log "  参与融合:"
    for d in "${prob_dirs[@]}"; do log "    - $d"; done

    run_step "grid_search" \
        python scripts/grid_search.py \
            --prob_dirs "${prob_dirs[@]}" \
            --ref_dir "$DATA_ROOT" \
            --folds_json "$FOLDS_JSON"
}

summary() {
    section "任务汇总"
    local n_done=0 n_fail=0 n_run=0 total=0
    for f in "$STATE_DIR"/*.state; do
        [[ -f "$f" ]] || continue
        IFS='|' read -r s t rc < "$f"
        case "$s" in
            done) n_done=$((n_done+1)); total=$((total+t)) ;;
            failed) n_fail=$((n_fail+1)) ;;
            running) n_run=$((n_run+1)) ;;
        esac
    done
    log "  ${C_GREEN}完成: $n_done${C_RST} | ${C_YELLOW}运行: $n_run${C_RST} | ${C_RED}失败: $n_fail${C_RST}"
    log "  累计训练时间: $(format_time $total)"
    log "  磁盘: $(df -h /root/autodl-tmp 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5")"}')"
    log "  /dev/shm: $(df -h /dev/shm | awk 'NR==2{print $3"/"$2" ("$5")"}')"
}

main() {
    local t0=$(date +%s)
    section "BraTS2021 Pipeline (200 epoch + 14GB 磁盘)"
    log "PROBS_DIR: $PROBS_DIR"
    log "MODE: smoke=$SMOKE_TEST  train=$RUN_TRAIN  infer=$RUN_INFER"

    check_env
    prepare_data

    if [[ "$SMOKE_TEST" == "1" ]]; then
        smoke_test
        summary
        exit 0
    fi

    if [[ "$RUN_TRAIN" == "1" ]]; then
        for MODEL in "${MONAI_MODELS[@]}"; do
            section "训练 ${MODEL}"
            for FOLD in "${FOLDS[@]}"; do
                train_and_predict_fold "$MODEL" "$FOLD" || true
                log "${C_CYAN}─── /dev/shm: $(df -h /dev/shm | awk 'NR==2{print $3"/"$2" ("$5")"}') ───${C_RST}"
            done
            merge_oof "$MODEL"
        done
    elif [[ "$RUN_INFER" == "1" ]]; then
        for MODEL in "${MONAI_MODELS[@]}"; do
            section "仅推理 ${MODEL}"
            for FOLD in "${FOLDS[@]}"; do
                local ckpt="$WORK_DIR/${MODEL}/fold_${FOLD}/best.pt"
                [[ ! -f "$ckpt" ]] && continue
                run_step "predict_${MODEL}_fold${FOLD}" \
                    python scripts/predict.py \
                        --base_config configs/base.yaml \
                        --model_config "configs/${MODEL}.yaml" \
                        --ckpt "$ckpt" --fold $FOLD \
                        --out_dir "${PROBS_DIR}/${MODEL}/fold_${FOLD}" \
                        --use_ema --tta \
                        --save_csv \
                        --model_name "$MODEL" || true
            done
            merge_oof "$MODEL"
        done
    fi

    if [[ "$RUN_INFER" == "1" ]]; then
        ensemble_and_search
    fi

    summary
    log "总耗时: $(format_time $(($(date +%s) - t0)))"
}

main "$@"
